{
  "name": "code2chill",
  "private": true,
  "version": "1.0.0",
  "description": "Code2Chill club website (MERN)",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,yellow \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "seed": "npm run seed -w server"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "puppeteer-core": "^25.18.1"
  }
}
